{% macro render(ctaData, apps) %}
<section class="final-cta">
  <div class="final-cta-box">
    {% if ctaData.eyebrow %}
    <p class="section-eyebrow">{{ ctaData.eyebrow }}</p>
    {% endif %}
    <h2>{{ ctaData.heading }}</h2>
    <p>{{ ctaData.subheading }}</p>

    <div class="final-web-actions">
      <a href="{{ ctaData.primaryCta.href }}" class="btn-web">
        {{ ctaData.primaryCta.label }}
      </a>
      {% if ctaData.secondaryCta %}
      <a href="{{ ctaData.secondaryCta.href }}" class="btn-secondary">
        {{ ctaData.secondaryCta.label }}
      </a>
      {% endif %}
    </div>

    {% if ctaData.androidPrompt %}
    <div class="android-download">
      <p>{{ ctaData.androidPrompt }}</p>
      <a href="{{ apps.androidStore }}" target="_blank" rel="noopener noreferrer" class="store-badge">
        <svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true">
          <path fill="#fff" d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.3,12.5L17.38,15.69L15.39,13.7L17.38,11.72L20.3,14.9C20.63,13.13 20.63,10.87 20.3,12.5M16.81,8.88L14.54,11.15L6.05,2.66L16.81,8.88Z" />
        </svg>
        <div class="store-text">
          <small>{{ ctaData.storeSmall }}</small>
          <strong>Google Play</strong>
        </div>
      </a>
    </div>
    {% endif %}
  </div>
</section>
{% endmacro %}
